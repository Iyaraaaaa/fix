  "privacyTitle": "Privacy Policy",
  "privacyLastUpdated": "Last updated: June 2025",
  "privacyIntro": "VeriFrame is committed to protecting your privacy. This policy explains how we collect, use, and safeguard your information when you use our deepfake detection platform.",
  "privacyS1Title": "Information We Collect",
  "privacyS1Body": "We collect information you provide directly, including video files uploaded for analysis, account credentials, and usage data. Uploaded videos are processed in real-time and are not stored permanently on our servers without your explicit consent.",
  "privacyS1B1": "Video content submitted for detection",
  "privacyS1B2": "Device identifiers and app usage metrics",
  "privacyS1B3": "Authentication data (Firebase Auth)",
  "privacyS1B4": "Analysis results and confidence logs",
  "privacyS2Title": "How We Use Your Data",
  "privacyS2Body": "Your data is used exclusively to provide deepfake detection services, improve our AI models, and enhance system reliability. We do not sell your personal data to third parties.",
  "privacyS2B1": "Real-time video analysis via our Agent Engine",
  "privacyS2B2": "Improving detection accuracy over time",
  "privacyS2B3": "Security monitoring and fraud prevention",
  "privacyS2B4": "Generating anonymized research insights",
  "privacyS3Title": "Data Storage & Security",
  "privacyS3Body": "All data is encrypted in transit and at rest. We use industry-standard security protocols including JWT authentication, Firebase security rules, and AWS S3 encryption to protect your information.",
  "privacyS3B1": "AES-256 encryption for stored data",
  "privacyS3B2": "TLS 1.3 for all data transmission",
  "privacyS3B3": "JWT-based session management",
  "privacyS3B4": "Regular security audits and penetration testing",
  "privacyS4Title": "Third-Party Services",
  "privacyS4Body": "VeriFrame integrates with trusted third-party services to deliver its functionality. Each service operates under its own privacy terms.",
  "privacyS4B1": "Firebase (Google) — Auth & database",
  "privacyS4B2": "AWS S3 — Secure video storage",
  "privacyS4B3": "Anthropic Claude API — AI reasoning engine",
  "privacyS4B4": "Node.js/Express backend — API layer",
  "privacyS5Title": "Your Rights",
  "privacyS5Body": "You have full control over your data. You may request access, correction, or deletion of your personal data at any time by contacting us.",
  "privacyS5B1": "Right to access your stored data",
  "privacyS5B2": "Right to request data deletion",
  "privacyS5B3": "Right to opt out of analytics",
  "privacyS5B4": "Right to data portability",
  "privacyS6Title": "Policy Updates",
  "privacyS6Body": "We may update this Privacy Policy periodically. Significant changes will be communicated via in-app notification. Continued use of VeriFrame after updates constitutes your acceptance of the revised policy.",
  "privacyContact": "Questions about this policy?\nveriframe.support@gmail.com",

  "aboutTagline": "DEEP LEARNING • AUTHENTICITY • TRUST",
  "aboutHero": "An intelligent system that sees through the synthetic — protecting truth in a world of AI-generated deception.",
  "aboutMissionLabel": "OUR MISSION",
  "aboutMission": "VeriFrame was built to address one of the most pressing challenges of the AI era: the proliferation of synthetic and manipulated video content. Our mission is to provide accessible, explainable, and accurate deepfake detection — making digital trust possible for everyone from journalists to law enforcement.",
  "aboutDifferentLabel": "WHAT MAKES US DIFFERENT",
  "aboutFeature1Title": "Agentic Reasoning Pipeline",
  "aboutFeature1Desc": "Unlike static ML classifiers, VeriFrame uses an AI agent that plans, reasons, and explains its detection process step by step — delivering transparent verdicts, not just predictions.",
  "aboutFeature2Title": "Explainable AI Detection",
  "aboutFeature2Desc": "Every analysis includes a confidence score and human-readable explanation of why a video is flagged — empowering users to understand and trust the result.",
  "aboutFeature3Title": "Mobile-First & Cloud-Powered",
  "aboutFeature3Desc": "Built with Flutter for seamless cross-platform access, backed by a Node.js API and Python agent engine — real-time deepfake analysis in your pocket.",
  "aboutFeature4Title": "Real-Time Adaptation",
  "aboutFeature4Desc": "Our system continuously improves through feedback loops, keeping pace with rapidly evolving deepfake generation techniques.",
  "aboutTechLabel": "TECHNOLOGY STACK",
  "aboutAppsLabel": "APPLICATIONS",
