# Veriframe Backend Configuration

# Model
MODEL_FALLBACK_PATHS=/app/assets/veriframe_model.tflite
INPUT_SIZE=224,224

# Frame Processing
TARGET_FRAMES=100
MAX_FRAMES=120
MIN_FACE_SIZE=40
BLUR_VAR_THRESHOLD=100.0
BRIGHTNESS_MIN=30.0
BRIGHTNESS_MAX=220.0

# Temporal Filtering
TEMPORAL_WINDOW_SIZE=15
STREAM_WINDOW_SIZE=30
CONFIDENCE_CALIBRATION_TEMP=1.5

# Performance
FRAME_EXTRACTION_WORKERS=4
INFERENCE_BATCH_SIZE=8
URL_DOWNLOAD_TIMEOUT=120

# Cache
CACHE_ENABLED=true
CACHE_DIR=/app/cache

# Database
DATABASE_URL=sqlite:///./veriframe.db

# Logging
LOG_LEVEL=INFO

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1

# Security
CORS_ORIGINS=*
API_KEY=